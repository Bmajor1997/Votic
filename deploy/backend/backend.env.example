# Copy outside the checkout to /etc/votic/backend.env, owner root, mode 0600.
# Enter secrets directly on the backend host; never commit the populated file.
FIREBASE_PROJECT_ID=votic-da5c4
REVENUECAT_ENTITLEMENT_ID=premium
VOTIC_MONTHLY_CREDITS=1000
REVENUECAT_SECRET_API_KEY=
OPENAI_API_KEY=
# Existing backend defaults; review these provider-spend safeguards before enabling AI.
VOTIC_AI_MONTHLY_BUDGET_USD=100
VOTIC_AI_USER_MONTHLY_BUDGET_USD=5
VOTIC_VOICE_QUESTIONS_ENABLED=false
# Leave credit-purchase products unconfigured until their separate setup is verified.

# Free beta is OFF unless explicitly enabled by the operator after approval.
# Values: off | allowlist | all-signed-in. Prefer allowlist with verified Firebase UIDs.
VOTIC_BETA_ACCESS_MODE=off
VOTIC_BETA_TESTER_UIDS=
# Beta shares VOTIC_MONTHLY_CREDITS (1000 above), the private persistent ledger,
# per-account token/USD limits and the global budget. Never use :memory: for beta.
