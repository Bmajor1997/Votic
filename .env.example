# Backend only. Copy to .env.backend.local (ignored) and edit locally; never paste a real key into chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
FIREBASE_PROJECT_ID=
# Backend-only RevenueCat REST API v1 key. Use the same entitlement ID as the mobile app.
# Required in production; setting the key also enforces Premium in local backend runs.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_ENTITLEMENT_ID=pro
# Production requires a private persistent volume, outside the public asset directory.
VOTIC_AI_USAGE_DB=./private/ai-usage.sqlite
VOTIC_AI_MONTHLY_TOKENS=2000000
VOTIC_AI_USER_MONTHLY_BUDGET_USD=5
VOTIC_AI_MONTHLY_BUDGET_USD=100
VOTIC_AI_CLIENT_DAILY_LIMIT=100
VOTIC_AI_DAILY_LIMIT=1000
VOTIC_AI_USER_RATE_LIMIT=20
VOTIC_AI_USER_CONCURRENCY=2
# Kill document parser workers after 15 seconds; extraction/OCR has a 40-second total server budget.
VOTIC_PARSER_TIMEOUT_MS=15000
VOTIC_VOICE_QUESTIONS_ENABLED=false
# Global answer-report storage caps; new reports fail explicitly when full.
VOTIC_REPORT_MAX_ROWS=10000
VOTIC_REPORT_MAX_BYTES=50000000
