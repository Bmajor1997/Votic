# Copy to apps/mobile/.env and fill in. Every value here is a PUBLIC client identifier that ships
# inside the app; never put secret keys (Firebase service accounts, RevenueCat secret API keys,
# Apple .p8 keys, Google service-account JSON) in this file.
# See apps/mobile/docs/ACCOUNTS_AND_SUBSCRIPTIONS.md.

# Firebase Authentication (Firebase console > Project settings > Your apps > Web app config)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google sign-in (see the README's "Accounts" section). Leave empty to hide "Continue with Google".
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Read by app.config.js at build time: the reversed iOS client ID (com.googleusercontent.apps.…).
GOOGLE_IOS_URL_SCHEME=

# RevenueCat public SDK keys (RevenueCat > Project > API keys). Leave empty until the stores are set up.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# The RevenueCat entitlement that unlocks Votic Premium (defaults to "pro").
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro

# Hosted legal pages, linked from Welcome, Create account, and Votic Premium. HTTPS only; leave empty until they exist.
EXPO_PUBLIC_VOTIC_TERMS_URL=
EXPO_PUBLIC_VOTIC_PRIVACY_URL=
