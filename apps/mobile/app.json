{
  "expo": {
    "name": "Votic",
    "slug": "votic",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "votic",
    "plugins": [
      "./plugins/withIconAliasIntentFilters",
      "expo-router",
      "@bacons/apple-targets",
      "expo-splash-screen",
      "expo-apple-authentication",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Votic to listen while you ask a voice question.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Votic to scan documents with your camera.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsFileWithMaxCount": 1,
              "supportsAttachmentsWithMaxCount": 1
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "application/pdf",
              "text/plain",
              "text/markdown",
              "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
              "application/vnd.openxmlformats-officedocument.presentationml.presentation",
              "application/vnd.ms-powerpoint",
              "application/epub+zip"
            ],
            "multipleShareMimeTypes": []
          }
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Orange",
            "ios": "./assets/app-icons/icon-orange.png",
            "android": {
              "foregroundImage": "./assets/app-icons/foreground-orange.png",
              "backgroundColor": "#ffffff"
            }
          },
          {
            "name": "Purple",
            "ios": "./assets/app-icons/icon-purple.png",
            "android": {
              "foregroundImage": "./assets/app-icons/foreground-purple.png",
              "backgroundColor": "#ffffff"
            }
          },
          {
            "name": "Red",
            "ios": "./assets/app-icons/icon-red.png",
            "android": {
              "foregroundImage": "./assets/app-icons/foreground-red.png",
              "backgroundColor": "#ffffff"
            }
          },
          {
            "name": "Teal",
            "ios": "./assets/app-icons/icon-teal.png",
            "android": {
              "foregroundImage": "./assets/app-icons/foreground-teal.png",
              "backgroundColor": "#ffffff"
            }
          },
          {
            "name": "Emerald",
            "ios": "./assets/app-icons/icon-emerald.png",
            "android": {
              "foregroundImage": "./assets/app-icons/foreground-emerald.png",
              "backgroundColor": "#ffffff"
            }
          },
          {
            "name": "Indigo",
            "ios": "./assets/app-icons/icon-indigo.png",
            "android": {
              "foregroundImage": "./assets/app-icons/foreground-indigo.png",
              "backgroundColor": "#ffffff"
            }
          },
          {
            "name": "Rose",
            "ios": "./assets/app-icons/icon-rose.png",
            "android": {
              "foregroundImage": "./assets/app-icons/foreground-rose.png",
              "backgroundColor": "#ffffff"
            }
          },
          {
            "name": "Amber",
            "ios": "./assets/app-icons/icon-amber.png",
            "android": {
              "foregroundImage": "./assets/app-icons/foreground-amber.png",
              "backgroundColor": "#ffffff"
            }
          }
        ]
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.votic.app",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.votic.app"]
      }
    },
    "android": {
      "package": "com.votic.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    }
  }
}
