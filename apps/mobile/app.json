{
  "expo": {
    "name": "Votic",
    "slug": "votic",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "votic",
    "plugins": [
      "expo-router",
      "@bacons/apple-targets",
      "expo-splash-screen",
      "expo-apple-authentication",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Votic to listen while you ask a voice question.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Votic to scan documents with your camera.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsFileWithMaxCount": 1,
              "supportsAttachmentsWithMaxCount": 1
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "application/pdf",
              "text/plain",
              "text/markdown",
              "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
              "application/vnd.openxmlformats-officedocument.presentationml.presentation",
              "application/vnd.ms-powerpoint",
              "application/epub+zip",
              "application/rtf",
              "text/rtf",
              "application/vnd.oasis.opendocument.text",
              "text/html",
              "image/jpeg",
              "image/png",
              "image/webp",
              "image/heic",
              "image/heif"
            ],
            "multipleShareMimeTypes": []
          }
        }
      ],
      "./plugins/withValidSharingIntentFilters",
      "./plugins/withAndroidLintResources",
      "./plugins/withNativeDependencyHardening"
    ],
    "ios": {
      "bundleIdentifier": "com.votic.app",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.votic.app"]
      }
    },
    "android": {
      "package": "com.votic.app",
      "icon": "./assets/android-icon/icon.png",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon/adaptive-foreground.png",
        "backgroundColor": "#D6EAFD",
        "backgroundImage": "./assets/android-icon/adaptive-background.png",
        "monochromeImage": "./assets/android-icon/adaptive-monochrome.png"
      },
      "blockedPermissions": ["android.permission.WRITE_EXTERNAL_STORAGE"]
    }
  }
}
