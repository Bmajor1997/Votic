<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/votic_widget_bg_chapter"
  android:orientation="vertical"
  android:padding="@dimen/votic_widget_padding">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">
    <LinearLayout
      android:id="@+id/cover"
      android:layout_width="34dp"
      android:layout_height="44dp"
      android:background="@drawable/votic_widget_cover"
      android:importantForAccessibility="noHideDescendants"
      android:orientation="vertical">
      <TextView
        android:id="@+id/cover_band"
        android:layout_width="match_parent"
        android:layout_height="11dp"
        android:background="@drawable/votic_widget_band_chapter"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="3dp"
        android:text="DOC"
        android:textColor="@color/votic_band_text"
        android:textSize="6sp"
        android:textStyle="bold" />
      <ImageView
      android:id="@+id/cover_line1"
      android:layout_width="match_parent"
      android:layout_height="3dp"
      android:layout_marginStart="4dp"
      android:layout_marginTop="5dp"
      android:layout_marginEnd="4dp"
      android:background="@drawable/votic_widget_line_chapter"
      android:importantForAccessibility="no" />
      <ImageView
      android:id="@+id/cover_line2"
      android:layout_width="16dp"
      android:layout_height="3dp"
      android:layout_marginStart="4dp"
      android:layout_marginTop="3dp"
      android:layout_marginEnd="4dp"
      android:background="@drawable/votic_widget_line_chapter"
      android:importantForAccessibility="no" />
      <ImageView
      android:id="@+id/cover_line3"
      android:layout_width="match_parent"
      android:layout_height="3dp"
      android:layout_marginStart="4dp"
      android:layout_marginTop="3dp"
      android:layout_marginEnd="4dp"
      android:background="@drawable/votic_widget_line_chapter"
      android:importantForAccessibility="no" />
    </LinearLayout>
    <FrameLayout
      android:layout_width="0dp"
      android:layout_height="1dp"
      android:layout_weight="1" />
    <FrameLayout
      android:layout_width="28dp"
      android:layout_height="28dp"
      android:background="@drawable/votic_widget_circle_chapter">
      <ImageView
        android:id="@+id/mode_icon"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/votic_widget_ic_headphones"
        android:tint="@color/votic_chapter_on_strong" />
    </FrameLayout>
  </LinearLayout>

  <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1" />

  <TextView
    android:id="@+id/title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="3"
    android:text="@string/votic_widget_sample_title"
    android:textColor="@color/votic_chapter_ink"
    android:textSize="15sp"
    android:textStyle="bold" />
  <ProgressBar
    android:id="@+id/progress"
    style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="match_parent"
    android:layout_height="5dp"
    android:layout_marginTop="7dp"
    android:importantForAccessibility="no"
    android:max="100"
    android:progress="0"
    android:progressDrawable="@drawable/votic_widget_progress_chapter" />
  <TextView
    android:id="@+id/status"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="@string/votic_widget_sample_status"
    android:textColor="@color/votic_chapter_detail"
    android:textSize="11sp" />
</LinearLayout>
