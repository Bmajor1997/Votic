<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Continue: the document in progress, with Listen and Read. -->
    <receiver
      android:name="com.votic.widgets.ContinueWidgetProvider"
      android:exported="true"
      android:label="@string/votic_widget_continue_name">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/votic_widget_continue_info" />
    </receiver>
    <!-- This Week: reading and listening time, day by day. -->
    <receiver
      android:name="com.votic.widgets.WeekWidgetProvider"
      android:exported="true"
      android:label="@string/votic_widget_week_name">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/votic_widget_week_info" />
    </receiver>
  </application>
</manifest>
